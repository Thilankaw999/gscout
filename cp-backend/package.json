{
  "name": "mitra-sls-api",
  "version": "1.0.0",
  "description": "",
  "author": "",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build --webpack",
    "build:all": "node scripts/build-all.js",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "dev": "npm run build && npx serverless offline --noPrependStageInUrl",
    "watch:service": "cross-env NODE_ENV=development node scripts/start-offine-watch-service.mjs",
    "lint": "npx eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "npx jest",
    "test:watch": "npx jest --watch",
    "test:cov": "npx jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "npx jest --config ./jest-e2e.json",
    "clean": "rimraf --glob \"apps/**/.dist\" \"apps/**/.serverless\" coverage .serverless dist",
    "predeploy": "npm run build:all",
    "deploy": "npx serverless deploy --stage ${npm_config_stage:-dev} --verbose",
    "deploy:service": "node scripts/deploy-service.js",
    "postdeploy": "npm run clean",
    "postdeploy:service": "npm run clean",
    "envsubst": "node scripts/envsubst.js",
    "prepare": "husky",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "sonar": "sonar-scanner"
  },
  "dependencies": {
    "@aws-crypto/client-node": "^4.0.2",
    "@aws-lambda-powertools/logger": "^2.7.0",
    "@aws-sdk/client-bedrock-agent-runtime": "^3.864.0",
    "@aws-sdk/client-bedrock-runtime": "^3.862.0",
    "@aws-sdk/client-dynamodb": "^3.797.0",
    "@aws-sdk/client-firehose": "^3.797.0",
    "@aws-sdk/client-lex-runtime-v2": "^3.856.0",
    "@aws-sdk/client-s3": "^3.797.0",
    "@aws-sdk/client-textract": "^3.797.0",
    "@aws-sdk/s3-presigned-post": "^3.797.0",
    "@aws-sdk/s3-request-presigner": "^3.797.0",
    "@aws-sdk/util-dynamodb": "^3.797.0",
    "@casl/ability": "^6.7.1",
    "@codegenie/serverless-express": "^4.14.1",
    "@nestjs/common": "^10.4.16",
    "@nestjs/core": "^10.4.16",
    "@nestjs/platform-express": "^10.4.16",
    "@nestjs/swagger": "^7.4.0",
    "@nestjs/typeorm": "^10.0.2",
    "@vendia/serverless-express": "^4.12.6",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "crypto": "^1.0.1",
    "csv-parser": "^3.0.0",
    "csv-stringify": "^6.5.2",
    "dayjs": "^1.11.13",
    "drizzle-kit": "^0.31.1",
    "drizzle-orm": "^0.44.2",
    "express": "^4.21.2",
    "lodash": "^4.17.21",
    "mysql2": "^3.14.1",
    "reflect-metadata": "^0.1.13",
    "sonar-scanner": "^3.1.0",
    "typeorm": "^0.3.20",
    "uuid": "^10.0.0",
    "webpack": "^5.99.9"
  },
  "devDependencies": {
    "@aws-sdk/client-cloudwatch-logs": "^3.797.0",
    "@aws-sdk/client-ecs": "^3.797.0",
    "@aws-sdk/client-lambda": "^3.797.0",
    "@aws-sdk/client-secrets-manager": "^3.797.0",
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/npm": "^12.0.1",
    "@serverless/compose": "^1.3.0",
    "@types/aws-lambda": "^8.10.150",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.2",
    "@types/node": "^20.3.1",
    "@types/supertest": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "aws-lambda": "^1.0.7",
    "chalk": "^5.3.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "husky": "^9.1.5",
    "jest": "^29.5.0",
    "jest-mock-extended": "^4.0.0-beta1",
    "lerna": "^8.1.8",
    "lint-staged": "^15.2.10",
    "nodemon": "^3.1.4",
    "prettier": "^3.0.0",
    "rimraf": "^6.0.1",
    "semantic-release": "^24.1.0",
    "serverless": "^4.14.4",
    "serverless-apigw-binary": "^0.4.4",
    "serverless-domain-manager": "^8.0.0",
    "serverless-fargate": "^0.0.12",
    "serverless-offline": "^14.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.3",
    "terser-webpack-plugin": "^5.3.10",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3",
    "webpack-bundle-analyzer": "^4.10.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.(t|j)s$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.ts",
      "!**/*e2e-spec.ts",
      "!**/main.ts",
      "!**/*api.module.ts"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/apps/",
      "<rootDir>/libs/"
    ],
    "moduleNameMapper": {
      "^@app/permissions(|/.*)$": "<rootDir>/libs/permissions/src/$1",
      "^@app/common(|/.*)$": "<rootDir>/libs/common/src/$1",
      "^@app/logger(|/.*)$": "<rootDir>/libs/logger/src/$1",
      "^@app/db(|/.*)$": "<rootDir>/libs/db/src/$1",
      "^@app/domain(|/.*)$": "<rootDir>/libs/domain/src/$1",
      "^@app/user-context(|/.*)$": "<rootDir>/libs/user-context/src/$1",
      "^@app/integrations(|/.*)$": "<rootDir>/libs/integrations/src/$1",
      "^@app/aws(|/.*)$": "<rootDir>/libs/aws/src/$1",
      "^@environment/(|/.*)$": "<rootDir>/environment/$1"
    },
    "setupFiles": [
      "<rootDir>/jest/setup.ts"
    ]
  },
  "lint-staged": {
    "*.{js, jsx,ts,tsx}": [
      "eslint --quiet --fix"
    ],
    "*.{json,js,ts,jsx,tsx,html}": [
      "prettier --write --ignore-unknown"
    ]
  },
  "overrides": {
    "@nestjs/platform-express": {
      "multer": "2.0.1"
    },
    "serverless-fargate": {
      "serverless": "2 || 3 || 4"
    }
  }
}
