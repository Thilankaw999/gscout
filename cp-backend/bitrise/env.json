{
  "apiDomain": "$ENV_SLS_API_DOMAIN",
  "webDomain": "$ENV_SLS_API_WEB_DOMAIN",
  "sslCertificateName": "*.mitrai.com",
  "domainCertificateId": "$ENV_DOMAIN_CERTIFICATE_ID",
  "apiGatewayEndpointType": "REGIONAL",
  "defaultRegion": "ap-south-1",
  "defaultAccount": "$ENV_AWS_ACCOUNT_ID",
  "vpc": {
    "vpcId": "$ENV_LAMBDA_VPC_ID",
    "subnetIds": [
      $ENV_LAMBDA_SUBNET_IDS
    ]
  },
  "database": {
    "user": "$ENV_SLS_API_DB_USER",
    "password": "$AWS_SLS_API_DB_PW",
    "host": "$ENV_SLS_API_DB_HOST",
    "port": "$ENV_SLS_API_DB_PORT",
    "database": "$ENV_SLS_API_DB_DATABSE"
  },
  "userPool": {
    "customAuthSubDomain": "$ENV_USER_POOL_CUSTOM_AUTH_SUB_DOMAIN",
    "id": "$ENV_USER_POOL_ID"
  },
  "isAuditEnabled": true,
  "stackName": "slsApi-infrastructure",
  "audit": {
    "s3": {
      "bucketName": "sls-api-audit"
    },
    "auditGlue": {
      "databaseName": "slsApi-logs-glue-database",
      "tableName": "slsApi-audit-logs-glue-table",
      "queryTableName": "slsApi-audit-logs-query-table"
    },
    "kinesis": {
      "auditEventDeliveryStream": "slsApiAuditEventDeliveryStream"
    }
  }
}